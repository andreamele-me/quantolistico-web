---
interface FooterLink {
  href: string;
  label: string;
}

interface SeqLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  pageTitle?: string;
  description: string;
  tagline: string;
  ctaSubject?: string;
  ctaLabel?: string;
  ctaEmail?: string;
  disclaimer?: string[];
  footerLinks?: FooterLink[];
  backLinkHref?: string;
  backLinkLabel?: string;
  crumbs?: boolean;
  showLogo?: boolean;
  noCache?: boolean;
  seqPrev?: SeqLink;
  seqNext?: SeqLink;
  ogImage?: string;
}

const {
  title,
  pageTitle = `${title} | Quantolistico`,
  description,
  tagline,
  ctaSubject,
  ctaLabel = 'Scrivimi',
  ctaEmail = 'otticomeleandrea@gmail.com',
  disclaimer = [],
  footerLinks = [],
  backLinkHref = 'index.html',
  backLinkLabel = 'Quantolistico',
  crumbs = false,
  showLogo = false,
  noCache = false,
  seqPrev,
  seqNext,
  ogImage = '/assets/og-default.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{noCache && <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">}
<title>{pageTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalUrl}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Quantolistico">
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={ogImageUrl}>
<meta property="og:locale" content="it_IT">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageUrl}>
<link rel="icon" href="/assets/logo-quantolistico.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <div class="wrap">
    <header>
      {crumbs ? (
        <p class="crumbs">
          <a class="back-link" href={backLinkHref}>{backLinkLabel}</a>
          <span class="crumb-sep" aria-hidden="true">·</span>
          <a class="back-link" href="index.html">Quantolistico</a>
        </p>
      ) : (
        <a class="back-link" href={backLinkHref}>{backLinkLabel}</a>
      )}
      {showLogo && (
        <div class="logo-badge small">
          <img class="logo" src="/assets/logo-quantolistico.svg" alt="Quantolistico">
        </div>
      )}
      <h1>{title}</h1>
      <p class="tagline">{tagline}</p>
    </header>

    <section class="content">
      <slot />
    </section>

    {disclaimer.length > 0 && (
      <div class="disclaimer">
        {disclaimer.map((p) => <p>{p}</p>)}
      </div>
    )}

    {ctaSubject && (
      <a class="cta" href={`mailto:${ctaEmail}?subject=${ctaSubject}`}>{ctaLabel}</a>
    )}

    {(seqPrev || seqNext) && (
      <nav class="seq-nav" aria-label="Nella sezione">
        {seqPrev && <a class="seq-prev" href={seqPrev.href}>{seqPrev.label}</a>}
        {seqNext && <a class="seq-next" href={seqNext.href}>{seqNext.label}</a>}
      </nav>
    )}

    <p class="indietro-wrap"><a class="back-link" href={backLinkHref}>{backLinkHref === 'index.html' ? 'Indietro' : 'Indice della sezione'}</a></p>

    <footer>
      <p class="brand-line">Quantolistico</p>
      {footerLinks.length > 0 && (
        <p class="site-links">
          {footerLinks.map((link, i) => (
            <>
              {i > 0 && ' '}
              <a href={link.href}>{link.label}</a>
            </>
          ))}
        </p>
      )}
      <p>&copy; 2026 Andrea Mele</p>
    </footer>
  </div>
</body>
</html>
