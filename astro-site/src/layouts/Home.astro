---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/assets/og-default.png' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalUrl}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Quantolistico">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={ogImageUrl}>
<meta property="og:locale" content="it_IT">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageUrl}>
<link rel="icon" href="/assets/logo-quantolistico.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/style.css">
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "name": "Andrea Mele",
      "url": "https://quantolistico.it/chi-sono.html",
      "jobTitle": "Ottico"
    },
    {
      "@type": "WebSite",
      "name": "Quantolistico",
      "url": "https://quantolistico.it/",
      "description": "Termine coniato da Andrea Mele. Ottica, luce e un percorso esplorativo tenuti distinti per competenza e per registro.",
      "author": {
        "@type": "Person",
        "name": "Andrea Mele"
      }
    }
  ]
}, null, 2)} />
</head>
<body class="home">
  <slot />
</body>
</html>
